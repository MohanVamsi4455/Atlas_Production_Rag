# =============================================================================
# Atlas settings template.
#   1. Copy this file to  .env  and fill in your own values.
#   2. NEVER commit .env (it is git-ignored). This template holds placeholders only.
#   3. Write values WITHOUT quotes (Docker's --env-file keeps quotes literally).
# Every setting is defined in app/config.py; anything you leave out uses its default.
# =============================================================================

# --- AWS (S3 document storage) ----------------------------------------------
AWS_REGION=ap-south-1
S3_BUCKET=your-s3-bucket-name
# Leave both blank to use an IAM role / AWS profile (recommended on EC2).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Chat models: providers are tried in this order (the next one is the failover) ---
CHAT_PROVIDER_ORDER=groq,gemini

# Groq Cloud (chat only): https://console.groq.com
GROQ_API_KEY=your-groq-api-key
GROQ_CHAT_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b

# Google Gemini (chat failover and embeddings): https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key
GEMINI_CHAT_MODELS=gemini-3.5-flash-lite,gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# Vector size. Must match the Pinecone index dimension. Do not change after indexing documents.
EMBED_DIM=1024

# --- Pinecone vector database (dense, 1024 dimensions; dotproduct = hybrid search) ---
PINECONE_API_KEY=your-pinecone-api-key
# A dotproduct index = hybrid search (dense + sparse in every record). It is created automatically if missing.
# An existing cosine index still works (dense-only).
PINECONE_INDEX_NAME=atlas-hybrid-index
PINECONE_METRIC=dotproduct
# Pinecone's hosted keyword model. Needs no statistics file.
SPARSE_MODEL=pinecone-sparse-english-v0
# Balance between meaning and keywords: 1.0 = only meaning, 0.0 = only keywords. Tune with scripts/compare_search.py
HYBRID_ALPHA=0.6
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=180

# --- Elasticsearch: BM25 keyword search (optional; leave both empty to not use it) ---
# Create these in Elastic Cloud; see docs/ELASTICSEARCH_SETUP.md
# For a self-hosted Elasticsearch (http://...) leave the key empty, e.g. ELASTIC_URL=http://localhost:9200 (docker-compose.elastic.yml).
ELASTIC_URL=
ELASTIC_API_KEY=
ELASTIC_INDEX=atlas-chunks
# A keyword hit must reach this BM25 score and this fraction of the best hit's score.
ELASTIC_MIN_SCORE=1.0
ELASTIC_MIN_RATIO=0.3
# auto = Elasticsearch if configured. Use none to switch it off, or pinecone to use Pinecone's sparse vectors instead.
KEYWORD_BACKEND=auto
# Weight of each list when merging meaning (Pinecone) and keywords (Elasticsearch). Equal = 1.0 and 1.0.
RRF_DENSE_WEIGHT=1.0
RRF_KEYWORD_WEIGHT=1.3

# --- PostgreSQL (Render "External Database URL") -------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# --- GlassFlow Rius tracing (optional; no data is sent without a key) ---------
RIUS_API_KEY=
RIUS_SERVICE_NAME=atlas-ai-enterprise
RIUS_DISABLED=false
# true would also record prompts and answers in traces; keep false for privacy.
RIUS_CAPTURE_CONTENT=false

# --- Application behaviour -----------------------------------------------------
MAX_UPLOAD_BYTES=10485760
# Minimum similarity (0-1) for a document passage to count as evidence.
MIN_RELEVANCE=0.25
# Require human approval for requests such as "delete the document".
HITL_ENABLED=true
# How many previous question/answer pairs the assistant remembers in a conversation.
MEMORY_TURNS=6
# redact = block IDs typed into questions and mask personal data; off = disable all PII handling.
PII_MODE=redact
